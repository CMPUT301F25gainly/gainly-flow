<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CreateEvent">

    <!-- Top purple header -->

    <TextView
        android:id="@+id/header_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Create Event"
        android:textStyle="bold"
        android:textSize="20sp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Event Name -->
    <EditText
        android:id="@+id/eventNameInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Event Name"
        android:inputType="textPersonName"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/header_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Event Description -->
    <EditText
        android:id="@+id/eventDescriptionInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Description"
        android:inputType="textMultiLine"
        android:gravity="top|start"
        android:minHeight="100dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/eventNameInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Registration Open -->
    <EditText
        android:id="@+id/registrationOpenInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Registration Opens"
        android:focusable="false"
        android:inputType="none"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/eventDescriptionInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Registration Close -->
    <EditText
        android:id="@+id/registrationCloseInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Registration Closes"
        android:focusable="false"
        android:inputType="none"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/registrationOpenInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Capacity -->
    <EditText
        android:id="@+id/eventCapacityInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Capacity"
        android:inputType="number"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/registrationCloseInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Geolocation Required -->
    <CheckBox
        android:id="@+id/geolocationCheckbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Geolocation Required"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/eventCapacityInput"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Save Button -->
    <Button
        android:id="@+id/saveEventButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Save Event"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/geolocationCheckbox"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>