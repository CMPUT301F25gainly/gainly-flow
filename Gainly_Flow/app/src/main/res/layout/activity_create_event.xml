<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CreateEvent">

    <!-- Sticky header (outside the scroll) -->
    <TextView
        android:id="@+id/header_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Create Event"
        android:textStyle="bold"
        android:textSize="20sp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:paddingStart="16dp"
        android:paddingEnd="16dp" />

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/createEventScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:importantForAutofill="noExcludeDescendants"
        app:layout_constraintTop_toBottomOf="@id/header_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Inner container for form fields -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/createEventContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- Event Name (top of inner parent) -->
            <EditText
                android:id="@+id/eventNameInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="Event Name"
                android:inputType="textPersonName"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Event Date -->
            <EditText
                android:id="@+id/eventDateInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="Date"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:clickable="true"
                android:inputType="none"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/eventNameInput"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Event Time -->
            <EditText
                android:id="@+id/eventTimeInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="Time"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:clickable="true"
                android:inputType="none"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/eventDateInput"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Event Description -->
            <EditText
                android:id="@+id/eventDescriptionInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="Description"
                android:inputType="textMultiLine"
                android:gravity="top|start"
                android:minHeight="100dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/eventTimeInput"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Registration Open -->
            <EditText
                android:id="@+id/registrationOpenInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="Registration Opens"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:clickable="true"
                android:inputType="none"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/eventDescriptionInput"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Registration Close -->
            <EditText
                android:id="@+id/registrationCloseInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="Registration Closes"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:clickable="true"
                android:inputType="none"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/registrationOpenInput"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Capacity -->
            <EditText
                android:id="@+id/eventCapacityInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="Capacity"
                android:inputType="number"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/registrationCloseInput"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Poster Preview -->
            <ImageView
                android:id="@+id/posterPreview"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:scaleType="centerCrop"
                android:contentDescription="Event Poster Preview"
                android:background="?attr/colorSurfaceVariant"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/eventCapacityInput"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
            <EditText
                android:id="@+id/posterUrlInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Paste poster image URL (optional)"
                app:layout_constraintTop_toBottomOf="@id/posterPreview"
                android:inputType="textUri"
                android:autofillHints="username"
                android:maxLines="1" />

            <!-- Select Poster Button -->
            <Button
                android:id="@+id/selectPosterBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Poster"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/posterUrlInput"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Geolocation Required -->
            <CheckBox
                android:id="@+id/geolocationCheckbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Geolocation Required"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/selectPosterBtn"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Save Button -->
            <Button
                android:id="@+id/saveEventButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Save Event"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/geolocationCheckbox"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
