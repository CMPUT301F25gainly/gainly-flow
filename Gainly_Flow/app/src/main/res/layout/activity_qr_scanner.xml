<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#0D1117"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".QRCodeScanner">

    <!-- ✅ Toolbar with Back Arrow -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#0D1117"
        android:title="QR Scanner"
        android:titleTextColor="#FFFFFF"
        app:navigationIcon="@drawable/ic_arrow_back_24"
        app:navigationIconTint="#FFFFFF"
        android:elevation="4dp" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvScanTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Scan QR Code"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"
        android:layout_gravity="center" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Scanning for Event QR Codes"
        android:textColor="#2F81F7"
        android:textSize="14sp"
        android:layout_marginBottom="24dp"
        android:layout_gravity="center" />

    <!-- QR Scanner Frame -->
    <com.journeyapps.barcodescanner.DecoratedBarcodeView
        android:id="@+id/cameraPreview"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_gravity="center"
        android:background="@drawable/qr_frame_glow"
        android:elevation="6dp"
        android:layout_marginBottom="24dp" />

    <!-- Camera Active Chip -->
    <com.google.android.material.chip.Chip
        android:id="@+id/chipCameraStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/Widget.Material3.Chip.Assist"
        android:text="Camera Active"
        android:textColor="#FFFFFF"
        app:chipBackgroundColor="@color/green_500"
        android:layout_gravity="center" />

    <!-- Instructions -->
    <TextView
        android:id="@+id/tvInstruction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Align the event QR code within the scanning area"
        android:textColor="#BBBBBB"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp" />

    <!-- Upload QR Image Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUploadQR"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/Widget.Material3.Button.TonalButton"
        android:text="Upload QR Image"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        app:icon="@android:drawable/ic_menu_upload"
        app:iconTint="#FFFFFF"
        android:backgroundTint="#2F81F7"
        app:cornerRadius="20dp"
        android:layout_gravity="center" />

</LinearLayout>
