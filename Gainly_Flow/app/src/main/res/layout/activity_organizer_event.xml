<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f5f5f5">

    <!-- Header Section with Purple Background -->
    <RelativeLayout
        android:id="@+id/header_section"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:background="@color/purple_500"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Back Button -->
        <ImageView
            android:id="@+id/back_button_organizer_event"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:src="@drawable/ic_arrow_back_24"
            android:contentDescription="Back"
            app:tint="@android:color/white" />

        <!-- Event Name in Header -->
        <TextView
            android:id="@+id/text_event_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Swimming Lessons"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@android:color/white" />

        <!-- Event Management Badge -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:text="Event Management"
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:alpha="0.9" />
    </RelativeLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/header_section"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Stats Cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <!-- Waiting List Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp"
                    android:background="@drawable/event_card_bg"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:id="@+id/text_waiting_list_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="45"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:textColor="#2196F3" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Waiting List"
                        android:textSize="14sp"
                        android:textColor="#666666" />
                </LinearLayout>

                <!-- Target Spots Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp"
                    android:background="@drawable/event_card_bg"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:id="@+id/text_target_spots"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="20"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:textColor="#4CAF50" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Target Spots"
                        android:textSize="14sp"
                        android:textColor="#666666" />
                </LinearLayout>
            </LinearLayout>

            <!-- Quick Actions Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Quick Actions"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/event_card_bg"
                android:padding="16dp"
                android:layout_marginBottom="24dp">


                <!-- New Button to View Waiting List -->
                <Button
                    android:id="@+id/btn_view_waiting_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="View Entrant Lists"
                    android:textColor="@android:color/white"
                    android:background="#FFFFFF"
                    android:textAllCaps="false"/>
                <!-- End New Button -->


                <Button
                    android:id="@+id/btn_update_poster"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#FFFFFF"
                    android:text="Update Event Poster"
                    android:textAllCaps="false"
                    android:textColor="@color/white" />
            </LinearLayout>

            <!-- Lottery Draw Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lottery Draw"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:id="@+id/lottery_section_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/event_card_bg"
                android:padding="16dp"
                android:layout_marginBottom="24dp">

                <!-- Number to Select Input -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Number to Select"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/et_number_to_select"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter the number of entrants to randomly select"
                    android:inputType="number"
                    android:text="20"
                    android:layout_marginBottom="16dp"
                    android:padding="12dp"
                    android:background="@drawable/event_card_bg" />

                <!-- Auto Notification Checkbox -->
                <CheckBox
                    android:id="@+id/cb_auto_notify"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Selected entrants will be notified automatically. Make sure you have set the correct number."
                    android:layout_marginBottom="16dp" />

                <!-- Run Lottery Button -->
                <Button
                    android:id="@+id/btn_run_lottery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Run Lottery Draw"
                    android:textAllCaps="false"
                    android:background="#4CAF50"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/btn_draw_replacement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Draw Replacement"
                    android:textAllCaps="false"
                    android:background="#4CAF50"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="16dp" />


            </LinearLayout>

            <!-- Notification Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Send Notification"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- Geolocation Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/event_card_bg"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Recipient Group -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Recipient Group"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Radio Group for Recipient Selection -->
                <RadioGroup
                    android:id="@+id/radio_group_recipient"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/radio_all_waitinglist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="All Waiting List" />

                    <RadioButton
                        android:id="@+id/radio_all_selected"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="All Selected" />

                    <RadioButton
                        android:id="@+id/radio_all_canceled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="All Canceled" />
                </RadioGroup>

                <!-- Message Input -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Message"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_message"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/event_card_bg"
                    android:gravity="top"
                    android:hint="Enter your message here..."
                    android:inputType="textMultiLine"
                    android:padding="12dp" />

                <!-- Send Notification Button -->
                <Button
                    android:id="@+id/btn_send_notification"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#FF9800"
                    android:text="Send Notification"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Geolocation"
                android:textSize="14sp"
                android:textColor="#666666"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp"
                android:padding="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Location tracking enabled for this event"
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_marginStart="32dp" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>