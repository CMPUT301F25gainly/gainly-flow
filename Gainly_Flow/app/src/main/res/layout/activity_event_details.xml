<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Top Banner -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="@drawable/blue_gradient_bg"
            android:padding="16dp">

            <!-- Back Button -->
            <ImageView
                android:id="@+id/back_button_event_detail"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentStart="true"
                android:layout_marginTop="8dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_arrow_back_24"
                android:contentDescription="Back"
                app:tint="@android:color/white" />

            <ImageView
                android:id="@+id/qr_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_qr_code_scan"
                android:contentDescription="QR Code Icon" />

        </RelativeLayout>

        <!-- Title and Subtitle -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/title_event"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Swimming Lessons"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                android:textColor="#000000"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/event_status" />

            <TextView
                android:id="@+id/event_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OPEN"
                android:textColor="#1FBF75"
                android:textStyle="bold"
                android:background="@drawable/status_badge"
                android:padding="6dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/title_event" />

            <TextView
                android:id="@+id/location_event"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Community Recreation Center"
                android:textSize="14sp"
                android:textColor="#666666"
                app:layout_constraintStart_toStartOf="@id/title_event"
                app:layout_constraintTop_toBottomOf="@id/title_event" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Waiting List Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/event_card_bg"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Waiting List"
                    android:textSize="14sp"
                    android:textColor="#555555" />

                <TextView
                    android:id="@+id/tvEntrants"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="45 entrants"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#0047FF" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Available Spots"
                    android:textSize="14sp"
                    android:textColor="#555555" />

                <TextView
                    android:id="@+id/tvAvailable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="20"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#1FBF75" />
            </LinearLayout>
        </LinearLayout>

        <!-- Event Schedule -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Event Schedule"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="20dp" />

        <LinearLayout
            android:id="@+id/schedule_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/event_card_bg"
            android:padding="16dp"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/event_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Event Date: "
                android:textSize="14sp" />

            <TextView
                android:id="@+id/registration_open"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Registration Opens: "
                android:textSize="14sp"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/registration_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Registration Closes: "
                android:textSize="14sp"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/event_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Event Time: "
                android:textSize="14sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- About Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="About This Event"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/event_card_bg"
            android:padding="16dp"
            android:orientation="vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/event_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Learn essential swimming skills in our beginner-friendly classes. Perfect for adults looking to build water confidence. Classes run every Monday and Wednesday from 6–7 PM."
                android:textSize="14sp" />

            <TextView
                android:id="@+id/event_location_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏊 Indoor Pool, Community Rec Center"
                android:textSize="14sp"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/event_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Price: $60 for full session"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/geolocation_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 Geolocation required for check-in"
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="24dp">

            <Button
                android:id="@+id/btnJoin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Join Waiting List"
                android:backgroundTint="#0047FF"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:padding="12dp" />

            <Space
                android:layout_width="8dp"
                android:layout_height="match_parent" />

            <Button
                android:id="@+id/btnLeave"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Leave List"
                android:backgroundTint="#E0E0E0"
                android:textColor="#000000"
                android:textSize="16sp"
                android:padding="12dp" />
        </LinearLayout>

        <!-- QR Code Section (Optional) -->
        <LinearLayout
            android:id="@+id/qr_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Event QR Code"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="12dp" />

            <ImageView
                android:id="@+id/qr_code_image"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:background="@android:color/white"
                android:padding="8dp" />

            <Button
                android:id="@+id/btn_share_qr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Share QR Code"
                android:layout_marginTop="12dp"
                android:backgroundTint="#666666" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>